[Unit]
Description=ssh-kex-tarpit (fake OpenSSH that stalls bots)
Requires=ssh-kex-tarpit.socket
After=ssh-kex-tarpit.socket

[Service]
ExecStart=/usr/bin/ssh-kex-tarpit
DynamicUser=yes
Restart=on-failure
RestartSec=5

# Caps --max-clients.
LimitNOFILE=8192
TasksMax=4
MemoryMax=128M
CPUQuota=25%
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000

# Empty root with only /usr mounted in. Sockets come from the .socket unit.
RootDirectory=/usr/share/ssh-kex-tarpit/root
BindReadOnlyPaths=/usr -/bin -/sbin -/lib -/lib64
TemporaryFileSystem=/usr/local:ro /run:ro /tmp:ro /var/tmp:ro /dev/shm:ro /dev/mqueue:ro
# systemd 257+ would mount the journal sockets in. Logging uses the inherited stdout.
BindLogSockets=no
PrivateNetwork=yes
# asyncio needs an AF_UNIX socketpair.
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ProtectProc=invisible
ProcSubset=pid
UMask=0077
RemoveIPC=yes
